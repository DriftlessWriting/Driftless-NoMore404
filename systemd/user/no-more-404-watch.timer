[Unit]
Description=Driftless-NoMore404 router health checks
Documentation=https://github.com/DriftlessWriting/Driftless-NoMore404
PartOf=no-more-404.target

[Timer]
# The timer is enabled, not started on its own: it is pulled in when the
# runtime target starts and stopped with it. First check is two minutes after
# the runtime starts, then every two minutes while it stays active.
OnActiveSec=2min
OnUnitActiveSec=2min
AccuracySec=1min

[Install]
WantedBy=no-more-404.target
