# Driftless-NoMore404 runtime configuration.
#
# This file is read by systemd. Keep it private (mode 0600), and use simple
# KEY=VALUE entries. Quote values containing spaces.

LLAMA_SERVER_BIN="/absolute/path/to/llama-server"
MODELS_PRESET="/absolute/path/to/models.ini"

# This release deliberately permits only loopback addresses.
BIND_HOST=127.0.0.1
PORT=55984

# Resource policy: cold-load the requested model, keep at most one resident,
# then release model weights and KV cache after one idle minute.
MAX_MODELS=1
IDLE_SECONDS=60
REQUEST_TIMEOUT_SECONDS=1800
ROUTER_START_TIMEOUT_SECONDS=20

# Optional observability endpoints are disabled by default.
ENABLE_METRICS=false
ENABLE_SLOTS=false

# While the runtime is active, a timer probes /health. The runtime target is
# restarted only after this many consecutive failed checks (minimum 2).
HEALTH_FAILURES_REQUIRED=2

# Optional. When omitted, this defaults to the user's XDG cache directory.
# LLAMA_CACHE_DIR="/absolute/path/to/a/private/cache"
